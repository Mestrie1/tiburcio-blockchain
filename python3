def keypair_from_hex(priv_hex):
    try:
        priv_bytes = binascii.unhexlify(priv_hex)
        return Keypair.from_secret_key(priv_bytes)
    except Exception as e:
        print("Erro ao converter chave privada:", e)
        exit(1)

